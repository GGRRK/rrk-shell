#!/usr/bin/env bash
# rrkshell — control script for the rrk-shell desktop.
#   rrkshell start            start wallpaper daemon + shell (idempotent)
#   rrkshell stop             stop the shell
#   rrkshell restart          restart the shell (use after editing QML)
#   rrkshell toggle <panel>   dashboard | notifications | launcher | wallpapers | media | bluetooth | network | power | clipboard | hotkeys
#   rrkshell wallpaper <file> set wallpaper (image, or a video = live wallpaper via mpvpaper), regenerate colours everywhere
#   rrkshell wallpaper random
#   rrkshell log              tail the shell log
#   rrkshell widgets          hide / show the desktop widgets (clock, visualizer, system monitor, weather)
#   rrkshell avatar [photo]   rebuild the lock-screen avatar (with a photo: it is copied to ~/.face first)
set -u

REPO="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF="$HOME/.config/rrk-shell"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/rrk-shell"
LOG="$STATE/shell.log"
QS_CONFIG="rrk-shell"          # ~/.config/quickshell/rrk-shell -> $REPO/shell
mkdir -p "$CONF" "$STATE"

settings() { # settings <jq-expr> <default>
    local v
    v=$(jq -r "$1 // empty" "$CONF/settings.json" 2>/dev/null)
    echo "${v:-$2}"
}

wallpaper_dir() { settings '.wallpaperDir' "$HOME/Pictures/Wallpapers" | sed "s|^~|$HOME|"; }

start_wallpaper_daemon() {
    if ! pgrep -x awww-daemon >/dev/null; then
        awww-daemon --format xrgb >/dev/null 2>&1 &
        for _ in $(seq 1 30); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
    fi
}

is_video() { case "${1,,}" in *.mp4|*.webm|*.mkv|*.mov) return 0 ;; *) return 1 ;; esac; }
MPV_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rrk-mpvpaper.sock"

# Live wallpaper = mpvpaper (AUR) looping the video on the background layer above awww's still (the poster frame).
# Software decoding (nouveau has no video decode), silent, cheap scaler. The shell pauses it over its IPC socket
# whenever a window covers the desktop (Wallpapers.qml), so it only really plays while the desktop is visible.
start_video_wallpaper() { # start_video_wallpaper <video>
    pgrep -af '^mpvpaper ' | grep -qF -- "$1" && return 0     # already playing this file (e.g. shell restart): keep it
    stop_video_wallpaper
    command -v mpvpaper >/dev/null || { echo "mpvpaper is not installed (paru -S mpvpaper) — showing the poster frame only" >&2; return 1; }
    mpvpaper -f -o "no-audio loop hwdec=no profile=fast input-ipc-server=$MPV_SOCK" '*' "$1" >/dev/null 2>&1
}
stop_video_wallpaper() { pkill -x mpvpaper 2>/dev/null || true; rm -f "$MPV_SOCK"; }

apply_wallpaper() { # apply_wallpaper <image|video> [--no-transition]
    local file="$1" img trans="${2:-}"
    [ -f "$file" ] || { echo "no such file: $file" >&2; return 1; }
    if is_video "$file"; then
        img="$("$REPO/shell/scripts/wallpaper-poster.sh" "$file")" || { echo "cannot extract a frame from $file (ffmpeg?)" >&2; return 1; }
    else
        img="$file"; stop_video_wallpaper
    fi
    start_wallpaper_daemon
    if [ "$trans" = "--no-transition" ]; then
        awww img "$img" --transition-type none
    else
        awww img "$img" --transition-type grow --transition-pos center --transition-fps 60 --transition-duration 1.2
    fi
    printf '%s' "$file" > "$STATE/wallpaper"
    if is_video "$file"; then
        [ "$trans" = "--no-transition" ] || sleep 1.2      # let the grow transition land on the poster first
        start_video_wallpaper "$file"
    fi
    matugen image "$img" -c "$REPO/matugen/config.toml" -m dark --prefer saturation >/dev/null 2>&1
    # kitty picks up colours live; Hyprland re-reads colors.lua on reload
    hyprctl reload >/dev/null 2>&1 || true
    pkill -USR1 -x kitty 2>/dev/null || true
    "$REPO/shell/scripts/lock-avatar.sh" 2>/dev/null || true   # lock-screen avatar follows the palette
}

random_wallpaper() {
    local dir; dir="$(wallpaper_dir)"
    find "$dir" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' \) | shuf -n1
}

cmd_start() {
    start_wallpaper_daemon
    local wp; wp="$(cat "$STATE/wallpaper" 2>/dev/null || true)"
    [ -f "$wp" ] || wp="$(random_wallpaper)"
    [ -n "$wp" ] && apply_wallpaper "$wp" --no-transition
    if ! pgrep -f "qs -c $QS_CONFIG" >/dev/null; then
        # setsid so the shell survives the caller (hyprland exec, terminal) exiting
        setsid -f qs -c "$QS_CONFIG" >>"$LOG" 2>&1
    fi
}

cmd_stop()    { pkill -f "qs -c $QS_CONFIG" 2>/dev/null || true; }   # mpvpaper keeps running: it belongs to the wallpaper, not the shell
cmd_restart() { cmd_stop; sleep 0.3; : > "$LOG"; cmd_start; }
cmd_toggle()  { qs -c "$QS_CONFIG" ipc call panels toggle "$1"; }

case "${1:-}" in
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    restart)   cmd_restart ;;
    toggle)    [ -n "${2:-}" ] || { echo "usage: rrkshell toggle <panel>" >&2; exit 1; }; cmd_toggle "$2" ;;
    widgets)   qs -c "$QS_CONFIG" ipc call widgets toggle ;;
    wallpaper) case "${2:-}" in
                   random) apply_wallpaper "$(random_wallpaper)" ;;
                   "")     echo "usage: rrkshell wallpaper <image>|random" >&2; exit 1 ;;
                   *)      apply_wallpaper "$2" ;;
               esac ;;
    log)       tail -n 50 -f "$LOG" ;;
    avatar)    if [ -n "${2:-}" ]; then magick identify -quiet -- "$2" >/dev/null 2>&1 || { echo "not an image: $2" >&2; exit 1; }; cp -- "$2" "$HOME/.face" || exit 1; fi
               "$REPO/shell/scripts/lock-avatar.sh" ;;
    *)         grep '^#   rrkshell' "$0" >&2; exit 1 ;;
esac
